# ---------------------------------------------------------------------------
# MeetPoint API — copy to server/.env and fill in.
# Never commit the real .env.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# --- Database --------------------------------------------------------------
# SQLite for local development:
DATABASE_URL=sqlite:///./meetpoint.db
# Postgres in production (Railway injects this automatically when you add the
# Postgres plugin). postgres:// and postgresql:// are both normalised.
# DATABASE_URL=postgresql://user:password@host:5432/meetpoint

# --- Auth ------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Set both when the API and the SPA live on different domains over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# Comma-separated. These addresses get role=admin on registration.
ADMIN_EMAILS=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed SPA origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Route optimizer -------------------------------------------------------
# The pickup-optimizer FastAPI service that computes meeting points.
OPTIMIZER_API_URL=https://meet-point-api-production.up.railway.app
OPTIMIZER_TIMEOUT_SECONDS=60

# --- Static frontend -------------------------------------------------------
# true = this service also serves the built SPA from ./dist (single deploy).
SERVE_STATIC=false
STATIC_DIR=dist