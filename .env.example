# ---------------------------------------------------------------------------
# Frontend (Vite) — copy to .env and fill in.
#
# WARNING: everything prefixed with VITE_ is embedded into the JavaScript
# bundle and is therefore PUBLIC. Never put a private secret here.
# ---------------------------------------------------------------------------

# Base URL of the MeetPoint API.
# Leave as-is in development: vite.config.js proxies /api to localhost:8000.
# For a separately-hosted API, use the full URL, e.g.
#   VITE_API_BASE_URL=https://meetpoint-api.up.railway.app/api/v1
VITE_API_BASE_URL=/api/v1

# Google Maps JavaScript API key (Maps JavaScript + Places + Geocoding).
# A Maps JS key is always visible to the browser — protect it in the Google
# Cloud Console instead:
#   1. APIs & Services > Credentials > your key
#   2. Application restrictions: HTTP referrers -> your domains only
#      (e.g. http://localhost:5173/*, https://yourdomain.com/*)
#   3. API restrictions: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=

# Optional: override the dev proxy target used by vite.config.js.
# VITE_DEV_API_PROXY=http://localhost:8000
