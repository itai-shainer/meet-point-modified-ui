{
  "name": "RouteHistory",
  "type": "object",
  "properties": {
    "driver_origin_address": {
      "type": "string",
      "description": "Driver's starting address"
    },
    "driver_origin_lat": {
      "type": "number",
      "description": "Driver's starting latitude"
    },
    "driver_origin_lng": {
      "type": "number",
      "description": "Driver's starting longitude"
    },
    "passenger_origin_address": {
      "type": "string",
      "description": "Passenger's starting address"
    },
    "passenger_origin_lat": {
      "type": "number",
      "description": "Passenger's starting latitude"
    },
    "passenger_origin_lng": {
      "type": "number",
      "description": "Passenger's starting longitude"
    },
    "destination_address": {
      "type": "string",
      "description": "Final destination address"
    },
    "destination_lat": {
      "type": "number",
      "description": "Final destination latitude"
    },
    "destination_lng": {
      "type": "number",
      "description": "Final destination longitude"
    },
    "api_response": {
      "type": "object",
      "description": "Complete API response with route details"
    },
    "is_direct_pickup": {
      "type": "boolean",
      "description": "Whether this was a direct pickup route"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Whether this route is marked as favorite"
    }
  },
  "required": [
    "driver_origin_address",
    "passenger_origin_address",
    "destination_address",
    "api_response"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}