{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "description": "Feedback message from user"
    },
    "contact_email": {
      "type": "string",
      "description": "Optional contact email"
    },
    "driver_origin": {
      "type": "string",
      "description": "Driver origin address if route feedback"
    },
    "passenger_origin": {
      "type": "string",
      "description": "Passenger origin address if route feedback"
    },
    "destination": {
      "type": "string",
      "description": "Destination address if route feedback"
    }
  },
  "required": [
    "message"
  ]
}